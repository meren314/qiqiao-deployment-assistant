{
  "manifest_version": 3,
  "name": "七巧部署助手",
  "version": "1.0.1",
  "description": "将本地页面目录中的四个标准文件准确写入、保存并按需发布到七巧编辑器。第三方工具，非官方产品。",
  "author": "meren314",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "七巧部署助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
